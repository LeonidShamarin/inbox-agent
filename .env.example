# Обов'язково: ключ Gemini (безкоштовного тіру достатньо).
# Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опційно: модель. Дефолт — gemini-3.5-flash-lite.
# AGENT_MODEL=gemini-3.5-flash-lite

# Опційно: бюджети однієї задачі. Дефолти в src/config.py.
# AGENT_MAX_STEPS=6
# AGENT_MAX_TOKENS=20000
# AGENT_TIMEOUT_S=60

# Опційно: порт HTTP-сервісу. Дефолт 7860.
# PORT=7860
